# Use forward slashes on Windows. For a portable install, select its inner ComfyUI folder.
# Use single quotes around paths containing a literal $, for example 'C:/Apps/Comfy$Studio'.
COMFYUI_DIR=/path/to/ComfyUI
# Optional: a separate category-based model folder already used by the host server.
# COMFYUI_MODELS_DIR=/path/to/models
# Persistent MPT config, model registrations, storage, fonts and music. Relative paths start in docker/.
# Save ComfyUI API exports in this directory under workflows/2.5.api.json,
# workflows/2.3.api.json or workflows/h3.api.json for the models you enable.
MPT_DATA_DIR=./data
MPT_MODELS=2.5
COMFYUI_ENDPOINT=http://127.0.0.1:8188
MPT_WEBUI_PORT=8501
