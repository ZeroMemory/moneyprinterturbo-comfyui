+def _render_nvidia_catalog_probe(public_endpoint, models, api_key):
+    state_key = "nvidia_catalog_probe_run"
+    if not public_endpoint:
+        st.session_state.pop(state_key, None)
+        return
+
+    api_key = llm.resolve_nvidia_api_key({"nvidia_api_key": api_key}, None)
+    context = (hashlib.sha256(api_key.encode()).digest(), tuple(models))
+    run = st.session_state.get(state_key)
+    if run and run["context"] != context:
+        st.session_state.pop(state_key)
+        run = None
+
+    st.caption(tr("NVIDIA Probe Help").format(count=len(models)))
+    started = st.button(
+        tr("Check all models"), key="probe_nvidia_catalog", disabled=not (api_key and models)
+    )
+    if started:
+        results = []
+        # A row click reruns the dialog while the other models are still being checked.
+        worker = Thread(target=results.extend, args=(llm.probe_nvidia_catalog(models, api_key),), daemon=True)
+        run = {"context": context, "results": results, "worker": worker, "table_id": uuid4().hex}
+        st.session_state[state_key] = run
+        worker.start()
+    if run is None:
+        return
+
+    polling = run["worker"].is_alive()
+
+    def show_results():
+        if st.session_state.get(state_key) is not run:
+            return
+        if run.pop("picked", False) or (polling and not run["worker"].is_alive()):
+            st.rerun()
+        results = run["results"].copy()
+        st.progress(len(results) / len(models), text=f"{len(results)} / {len(models)}")
+        if results:
+            table_key = f"nvidia_probe_{run['table_id']}_{st.session_state['nvidia_model_name_select']}"
+
+            def pick_model():
+                if st.session_state.get(state_key) is not run:
+                    return
+                selected = st.session_state[table_key].selection
+                rows = selected.rows or [cell[0] for cell in selected.cells]
+                if rows and 0 <= rows[0] < len(results):
+                    st.session_state["nvidia_model_name_select"] = results[rows[0]]["model"]
+                    if polling:
+                        run["picked"] = True
+
+            st.dataframe(
+                [
+                    {
+                        tr("Model Name"): result["model"],
+                        tr("Task Status"): tr("NVIDIA Probe " + result["status"])
+                        + (f" ({result['http_status']})" if result["http_status"] else ""),
+                        tr("NVIDIA Probe Latency"): result["latency_ms"],
+                    }
+                    for result in results
+                ],
+                hide_index=True,
+                key=table_key,
+                selection_mode=["single-row", "single-cell"],
+                on_select=pick_model,
+            )
+
+        if not polling and len(results) < len(models):
+            st.caption(tr("NVIDIA Probe Interrupted"))
+
+    if polling:
+        st.fragment(run_every=0.5)(show_results)()
+    else:
+        show_results()
+
