+def _render_ltx_resolution(params, scale, restored):
+    model, aspect = params.ltx_model_version, params.video_aspect
+    presets = ltx.resolution_presets(model, aspect)
+    recommended = presets["recommended"]
+    labels = {(w, h): f"{w} × {h}" for w, h in presets.values()}
+    labels[recommended] += f" · {tr('Recommended clip size')}"
+    labels["custom"] = tr("Custom clip size")
+    key = f"ltx_size_{model}_{aspect.value}"
+    fields = (f"{key}_width", f"{key}_height")
+    minimum, maximum, step = ltx.generation_dimension_limits(model)
+    if restored == (None, None):
+        # Tasks saved before clip dimensions were recorded used the first-pass size times the workflow scale.
+        restored = tuple(side * scale for side in ltx.ltx_resolution_for_aspect(aspect, model))
+    stored = restored if restored is not None else config.snapshot_config_with_pending(config.ui).get(key)
+    size = recommended
+    if isinstance(stored, (list, tuple)) and len(stored) == 2 and all(
+        type(side) is int and minimum <= side <= maximum and side % step == 0 for side in stored
+    ):
+        size = tuple(stored)
+    mode = size if size in labels else "custom"
+    if restored is not None:
+        _set_stable_widget_value(key, mode)
+        if mode == "custom":
+            st.session_state[fields[0]], st.session_state[fields[1]] = size
+
+    def save_choice():
+        choice = st.session_state[localized_widget_key(key)]
+        if choice == "custom":
+            st.session_state[fields[0]], st.session_state[fields[1]] = size
+            choice = size
+        _set_runtime_config("ui", key, list(choice))
+
+    def save_dimension(field):
+        # Typed values can bypass number_input's +/- step.
+        value = st.session_state[field]
+        st.session_state[field] = ((value + step // 2) // step) * step
+        _set_runtime_config("ui", key, [st.session_state[k] for k in fields])
+
+    mode = stable_selectbox(tr("Generated clip size"), labels, mode, key, format_func=labels.get, on_change=save_choice)
+    if mode == "custom":
+        st.caption(tr("Clip size step").format(step=step))
+        dimensions = []
+        for column, field, label, side in zip(
+            st.columns(2), fields, (tr("Clip width (px)"), tr("Clip height (px)")), size
+        ):
+            st.session_state.setdefault(field, side)
+            dimensions.append(column.number_input(
+                label, min_value=minimum, max_value=maximum, step=step,
+                key=field, on_change=save_dimension, args=(field,),
+            ))
+        size = tuple(dimensions)
+    else:
+        size = mode
+    params.ltx_generation_width, params.ltx_generation_height = size
+    st.caption(tr("Clip and final video size").format(size=f"{size[0]} × {size[1]}"))
+
