@@ -1,4 +1,49 @@
 import os
+import tempfile
+from pathlib import Path
+
+
+def upload_filename(filename: str) -> str:
+    name = (filename or '').replace('\\', '/').split('/')[-1].strip()
+    reserved = {'CON', 'PRN', 'AUX', 'NUL', *(f'COM{i}' for i in range(1, 10)), *(f'LPT{i}' for i in range(1, 10))}
+    if (not name or name in {'.', '..'} or name[-1] in ' .'
+            or any(ord(char) < 32 or char in '<>:"|?*' for char in name)
+            or name.split('.')[0].rstrip(' ').upper() in reserved):
+        raise ValueError('Invalid upload filename')
+    return name
+
+
+def store_upload(directory: str, filename: str, content) -> str:
+    name = upload_filename(filename)
+    destination = Path(directory).absolute() / name
+    resolve_path_within_directory(str(destination.parent), name, require_file=False)
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    temporary = None
+    try:
+        with tempfile.NamedTemporaryFile(dir=destination.parent, prefix='.upload-', delete=False) as stream:
+            temporary = Path(stream.name)
+            stream.write(content)
+        temporary.replace(destination)
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
+    return str(destination)
+
+
+def ensure_output_path(output_path: str, input_paths) -> None:
+    output = os.path.normcase(os.path.realpath(output_path))
+    for source in input_paths:
+        if source is None:
+            continue
+        source = os.path.realpath(source)
+        directory_alias = os.path.isdir(source) and os.path.exists(output) and any(
+            item.is_file() and os.path.samefile(output, item) for item in Path(source).rglob("*")
+        )
+        if output == os.path.normcase(os.path.realpath(source)) or (
+            os.path.exists(output) and os.path.exists(source)
+            and os.path.samefile(output, source)
+        ) or directory_alias:
+            raise ValueError(f"Output would overwrite an input: {source}")
 
 
 def resolve_path_within_directory(
